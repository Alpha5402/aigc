# AgriCloud Forecast Model_Service runtime config
# Copy this file to model-service/.env and edit before first run.

# REQUIRED: must match MODEL_SERVICE_SHARED_SECRET in backend/.env on ysngj.cn
FORECAST_SHARED_SECRET=

# Replay-protection cache TTL (seconds). Default 300 = 5 minutes.
FORECAST_NONCE_TTL_SECONDS=300

# Max concurrent inferences per request fan-out. 4 is safe on a single GPU.
MODEL_INFERENCE_CONCURRENCY=4

# Where model weights / cached fits live. Use AutoDL persistent storage path.
MODEL_ARTIFACT_DIR=/root/autodl-tmp/agricloud-forecast/artifacts

LOG_LEVEL=INFO

# AutoDL custom-service mappings require 0.0.0.0; on a private LAN use 127.0.0.1.
HOST=0.0.0.0
PORT=8000
